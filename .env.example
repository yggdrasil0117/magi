# Required by the production API factory.
OPENAI_API_KEY=
MAGI_OPENAI_MODEL=

# Production requires explicit skill and authorization-policy paths.
MAGI_SKILLS_DIR=./skills
MAGI_AUTH_POLICY_FILE=./config/auth-policy.json

# PostgreSQL for durable invocation records and LangGraph checkpoints.
MAGI_DATABASE_URL=postgresql://magi:change-me@127.0.0.1:5432/magi
MAGI_POSTGRES_MIN_SIZE=1
MAGI_POSTGRES_MAX_SIZE=10

# Total attempts per perspective model call, including the first attempt.
MAGI_MODEL_MAX_ATTEMPTS=2

# Read-only evidence retrieval is disabled until exact HTTPS hosts are listed.
MAGI_EVIDENCE_ALLOWED_HOSTS=
MAGI_EVIDENCE_TIMEOUT_SECONDS=8
MAGI_EVIDENCE_MAX_RESPONSE_BYTES=20000

# Optional integration-test database. Never point this at production.
MAGI_TEST_POSTGRES_DSN=

# Explicit opt-in for the paid/live M2 acceptance test. Keep disabled by default.
MAGI_RUN_M2_LIVE=0
